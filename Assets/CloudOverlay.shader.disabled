Shader "UI/CloudOverlay"
{
    Properties
    {
        _MainTex ("Noise", 2D) = "white" {}
        _Speed ("Speed", Float) = 0.05
        _Strength ("Strength", Float) = 0.6
    }

    SubShader
    {
        Tags { "Queue"="Transparent" "RenderType"="Transparent" }
        Blend SrcAlpha OneMinusSrcAlpha
        ZWrite Off
        Cull Off
        Lighting Off

        Pass
        {
            CGPROGRAM
            #pragma vertex vert
            #pragma fragment frag
            #include "UnityCG.cginc"

            sampler2D _MainTex;
            float _Speed;
            float _Strength;

            struct appdata
            {
                float4 vertex : POSITION;
                float2 uv : TEXCOORD0;
            };

            struct v2f
            {
                float4 pos : SV_POSITION;
                float2 uv : TEXCOORD0;
            };

            v2f vert (appdata v)
            {
                v2f o;
                o.pos = UnityObjectToClipPos(v.vertex);
                o.uv = v.uv;
                return o;
            }

            fixed4 frag (v2f i) : SV_Target
            {
                float2 uv = i.uv;
                uv += _Time.y * _Speed;

                float n = tex2D(_MainTex, uv).r;
                float a = smoothstep(0.2, 0.8, n) * _Strength;

                return fixed4(1,1,1,a);
            }
            ENDCG
        }
    }
}